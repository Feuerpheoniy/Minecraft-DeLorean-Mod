{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.feuerpheoniy.delorean.doors": {
      "initial_state": "closed",
      "states": {
        "closed": {
          "transitions": [
            {
              "open": "query.property('feuerpheoniy:doors_open')"
            }
          ]
        },
        "open": {
          "animations": [
            "animation.feuerpheoniy.delorean.doors_open"
          ],
          "transitions": [
            {
              "closed": "!query.property('feuerpheoniy:doors_open')"
            }
          ]
        }
      }
    }
  }
}
